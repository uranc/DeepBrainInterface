<?xml version="1.0" encoding="utf-8"?>
<WorkflowBuilder Version="2.9.1"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xmlns:onix1="clr-namespace:OpenEphys.Onix1;assembly=OpenEphys.Onix1"
                 xmlns:rx="clr-namespace:Bonsai.Reactive;assembly=Bonsai.Core"
                 xmlns:io="clr-namespace:Bonsai.IO;assembly=Bonsai.System"
                 xmlns:p1="clr-namespace:OpenEphys.Sockets.Bonsai;assembly=OpenEphys.Sockets.Bonsai"
                 xmlns:p2="clr-namespace:DeepBrainInterface;assembly=DeepBrainInterface"
                 xmlns:dsp="clr-namespace:Bonsai.Dsp;assembly=Bonsai.Dsp"
                 xmlns:scr="clr-namespace:Bonsai.Scripting.Expressions;assembly=Bonsai.Scripting.Expressions"
                 xmlns:p3="clr-namespace:OpenEphys.Onix1.DataFrameWriter;assembly=OpenEphys.Onix1"
                 xmlns:p4="clr-namespace:Bonsai.Ephys.Design;assembly=Bonsai.Ephys.Design"
                 xmlns="https://bonsai-rx.org/2018/workflow">
  <Workflow>
    <Nodes>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:CreateContext">
          <onix1:Driver>riffa</onix1:Driver>
          <onix1:Index>0</onix1:Index>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:ConfigureBreakoutBoard">
          <onix1:Name>BreakoutBoard</onix1:Name>
          <onix1:Heartbeat>
            <onix1:DeviceName>BreakoutBoard/PersistentHeartbeat</onix1:DeviceName>
            <onix1:DeviceAddress>0</onix1:DeviceAddress>
            <onix1:BeatsPerSecond>100</onix1:BeatsPerSecond>
          </onix1:Heartbeat>
          <onix1:AnalogIO>
            <onix1:DeviceName>BreakoutBoard/AnalogIO</onix1:DeviceName>
            <onix1:DeviceAddress>6</onix1:DeviceAddress>
            <onix1:Enable>false</onix1:Enable>
            <onix1:InputRange0>TenVolts</onix1:InputRange0>
            <onix1:InputRange1>TenVolts</onix1:InputRange1>
            <onix1:InputRange2>TenVolts</onix1:InputRange2>
            <onix1:InputRange3>TenVolts</onix1:InputRange3>
            <onix1:InputRange4>TenVolts</onix1:InputRange4>
            <onix1:InputRange5>TenVolts</onix1:InputRange5>
            <onix1:InputRange6>TenVolts</onix1:InputRange6>
            <onix1:InputRange7>TenVolts</onix1:InputRange7>
            <onix1:InputRange8>TenVolts</onix1:InputRange8>
            <onix1:InputRange9>TenVolts</onix1:InputRange9>
            <onix1:InputRange10>TenVolts</onix1:InputRange10>
            <onix1:InputRange11>TenVolts</onix1:InputRange11>
            <onix1:Direction0>Input</onix1:Direction0>
            <onix1:Direction1>Input</onix1:Direction1>
            <onix1:Direction2>Input</onix1:Direction2>
            <onix1:Direction3>Input</onix1:Direction3>
            <onix1:Direction4>Input</onix1:Direction4>
            <onix1:Direction5>Input</onix1:Direction5>
            <onix1:Direction6>Input</onix1:Direction6>
            <onix1:Direction7>Input</onix1:Direction7>
            <onix1:Direction8>Input</onix1:Direction8>
            <onix1:Direction9>Input</onix1:Direction9>
            <onix1:Direction10>Input</onix1:Direction10>
            <onix1:Direction11>Input</onix1:Direction11>
          </onix1:AnalogIO>
          <onix1:DigitalIO>
            <onix1:DeviceName>BreakoutBoard/DigitalIO</onix1:DeviceName>
            <onix1:DeviceAddress>7</onix1:DeviceAddress>
            <onix1:Enable>true</onix1:Enable>
            <onix1:DeadTime>0</onix1:DeadTime>
            <onix1:SampleRate xsi:nil="true" />
          </onix1:DigitalIO>
          <onix1:ClockOutput>
            <onix1:DeviceName>BreakoutBoard/OutputClock</onix1:DeviceName>
            <onix1:DeviceAddress>5</onix1:DeviceAddress>
            <onix1:ClockGate>false</onix1:ClockGate>
            <onix1:Frequency>1000000</onix1:Frequency>
            <onix1:DutyCycle>50</onix1:DutyCycle>
            <onix1:Delay>0</onix1:Delay>
          </onix1:ClockOutput>
          <onix1:HarpInput>
            <onix1:DeviceName>BreakoutBoard/HarpSyncInput</onix1:DeviceName>
            <onix1:DeviceAddress>12</onix1:DeviceAddress>
            <onix1:Enable>false</onix1:Enable>
            <onix1:Source>Breakout</onix1:Source>
          </onix1:HarpInput>
          <onix1:MemoryMonitor>
            <onix1:DeviceName>BreakoutBoard/MemoryMonitor</onix1:DeviceName>
            <onix1:DeviceAddress>10</onix1:DeviceAddress>
            <onix1:Enable>true</onix1:Enable>
            <onix1:SamplesPerSecond>10</onix1:SamplesPerSecond>
          </onix1:MemoryMonitor>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:ConfigureHeadstage64">
          <onix1:Name>Headstage64</onix1:Name>
          <onix1:Rhd2164>
            <onix1:DeviceName>Headstage64/Rhd2164</onix1:DeviceName>
            <onix1:DeviceAddress>256</onix1:DeviceAddress>
            <onix1:Enable>true</onix1:Enable>
            <onix1:DspCutoff>Off</onix1:DspCutoff>
            <onix1:AnalogLowCutoff>Low100mHz</onix1:AnalogLowCutoff>
            <onix1:AnalogHighCutoff>High10000Hz</onix1:AnalogHighCutoff>
          </onix1:Rhd2164>
          <onix1:Bno055>
            <onix1:DeviceName>Headstage64/Bno055</onix1:DeviceName>
            <onix1:DeviceAddress>257</onix1:DeviceAddress>
            <onix1:Enable>true</onix1:Enable>
          </onix1:Bno055>
          <onix1:TS4231>
            <onix1:DeviceName>Headstage64/TS4231V1</onix1:DeviceName>
            <onix1:DeviceAddress>258</onix1:DeviceAddress>
            <onix1:Enable>false</onix1:Enable>
          </onix1:TS4231>
          <onix1:ElectricalStimulator>
            <onix1:DeviceName>Headstage64/Headstage64ElectricalStimulator</onix1:DeviceName>
            <onix1:DeviceAddress>259</onix1:DeviceAddress>
            <onix1:Arm>false</onix1:Arm>
            <onix1:TriggerDelay>0</onix1:TriggerDelay>
            <onix1:PhaseOneCurrent>200</onix1:PhaseOneCurrent>
            <onix1:InterPhaseCurrent>0</onix1:InterPhaseCurrent>
            <onix1:PhaseTwoCurrent>0</onix1:PhaseTwoCurrent>
            <onix1:PhaseOneDuration>200</onix1:PhaseOneDuration>
            <onix1:InterPhaseInterval>0</onix1:InterPhaseInterval>
            <onix1:PhaseTwoDuration>0</onix1:PhaseTwoDuration>
            <onix1:InterPulseInterval>0</onix1:InterPulseInterval>
            <onix1:InterBurstInterval>0</onix1:InterBurstInterval>
            <onix1:BurstPulseCount>0</onix1:BurstPulseCount>
            <onix1:TrainBurstCount>0</onix1:TrainBurstCount>
          </onix1:ElectricalStimulator>
          <onix1:OpticalStimulator>
            <onix1:DeviceName>Headstage64/Headstage64OpticalStimulator</onix1:DeviceName>
            <onix1:DeviceAddress>260</onix1:DeviceAddress>
            <onix1:Arm>false</onix1:Arm>
            <onix1:Delay>0</onix1:Delay>
            <onix1:MaxCurrent>10</onix1:MaxCurrent>
            <onix1:ChannelOneCurrent>50</onix1:ChannelOneCurrent>
            <onix1:ChannelTwoCurrent>0</onix1:ChannelTwoCurrent>
            <onix1:PulseDuration>10</onix1:PulseDuration>
            <onix1:PulsesPerSecond>1</onix1:PulsesPerSecond>
            <onix1:PulsesPerBurst>1</onix1:PulsesPerBurst>
            <onix1:InterBurstInterval>0</onix1:InterBurstInterval>
            <onix1:BurstsPerTrain>1</onix1:BurstsPerTrain>
          </onix1:OpticalStimulator>
          <onix1:Port>PortA</onix1:Port>
          <onix1:PortVoltage>
            <onix1:Requested>8</onix1:Requested>
          </onix1:PortVoltage>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:StartAcquisition">
          <onix1:ReadSize>2048</onix1:ReadSize>
          <onix1:WriteSize>2048</onix1:WriteSize>
        </Combinator>
      </Expression>
      <Expression xsi:type="GroupWorkflow">
        <Name>SaveHeadstageTimestamp</Name>
        <Description />
        <Workflow>
          <Nodes>
            <Expression xsi:type="WorkflowInput">
              <Name>Source1</Name>
            </Expression>
            <Expression xsi:type="Combinator">
              <Combinator xsi:type="rx:Timestamp" />
            </Expression>
            <Expression xsi:type="io:CsvWriter">
              <io:FileName>start-time_.csv</io:FileName>
              <io:Append>false</io:Append>
              <io:Overwrite>false</io:Overwrite>
              <io:Suffix>FileCount</io:Suffix>
              <io:IncludeHeader>true</io:IncludeHeader>
              <io:Selector>Timestamp,Value.AcquisitionClockHz,Value.BlockReadSize,Value.BlockWriteSize</io:Selector>
            </Expression>
          </Nodes>
          <Edges>
            <Edge From="0" To="1" Label="Source1" />
            <Edge From="1" To="2" Label="Source1" />
          </Edges>
        </Workflow>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p1:TcpServer">
          <p1:Name>SendToGUI</p1:Name>
          <p1:Port>9001</p1:Port>
          <p1:Address>localhost</p1:Address>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:RealtimeConfig">
          <p2:ProcessPriority>High</p2:ProcessPriority>
          <p2:TimerResolutionMs>0.5</p2:TimerResolutionMs>
          <p2:TimerResolution1ms>true</p2:TimerResolution1ms>
          <p2:GcLatencyMode>Interactive</p2:GcLatencyMode>
          <p2:DisablePowerThrottling>true</p2:DisablePowerThrottling>
          <p2:RestrictToPerformanceCores>false</p2:RestrictToPerformanceCores>
          <p2:AffinityMaskHex />
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:Rhd2164Data">
          <onix1:DeviceName>Headstage64/Rhd2164</onix1:DeviceName>
          <onix1:BufferSize>24</onix1:BufferSize>
        </Combinator>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>AmplifierData</Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Clock</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Zip" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:Bno055Data">
          <onix1:DeviceName>Headstage64/Bno055</onix1:DeviceName>
        </Combinator>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Acceleration</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:BnoMovementDetector">
          <p2:Alpha>0.01</p2:Alpha>
          <p2:Threshold>1</p2:Threshold>
          <p2:MedianWindow>5</p2:MedianWindow>
        </Combinator>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>IsActive</Selector>
      </Expression>
      <Expression xsi:type="BitwiseNot" />
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:StartWithBool">
          <p2:Value>true</p2:Value>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:WithLatestFrom" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:RippleSuperNode">
          <p2:Channels>
            <p2:int>24</p2:int>
            <p2:int>25</p2:int>
            <p2:int>25</p2:int>
            <p2:int>35</p2:int>
            <p2:int>35</p2:int>
            <p2:int>31</p2:int>
            <p2:int>29</p2:int>
            <p2:int>28</p2:int>
          </p2:Channels>
          <p2:DecimationFactor>12</p2:DecimationFactor>
          <p2:PhaseCount>1</p2:PhaseCount>
          <p2:Preprocessing>ZScore</p2:Preprocessing>
          <p2:ZScoreWindow>1250</p2:ZScoreWindow>
          <p2:ZScoreEps>1E-08</p2:ZScoreEps>
          <p2:EmaAlpha>0.01</p2:EmaAlpha>
          <p2:ModelPath>D:\BonsaiModels\ES_model_tripletClean1450.onnx</p2:ModelPath>
          <p2:ModelPath2 />
          <p2:TimePoints>44</p2:TimePoints>
          <p2:Stride>2</p2:Stride>
          <p2:Decision>Fsm</p2:Decision>
          <p2:HoldThreshold>0.5</p2:HoldThreshold>
          <p2:HoldConsecutive>3</p2:HoldConsecutive>
          <p2:UseHardwareClock>false</p2:UseHardwareClock>
          <p2:HardwareClockHz>250000000</p2:HardwareClockHz>
          <p2:SnapshotEnabled>false</p2:SnapshotEnabled>
          <p2:ActiveModels>0</p2:ActiveModels>
          <p2:Combiner>First</p2:Combiner>
          <p2:DetectionEnabled>true</p2:DetectionEnabled>
          <p2:Threshold1_IgnoreBelow>0.6</p2:Threshold1_IgnoreBelow>
          <p2:Threshold2_WeakEvidence>0.7</p2:Threshold2_WeakEvidence>
          <p2:Threshold3_StrongEvidence>0.8</p2:Threshold3_StrongEvidence>
          <p2:TargetEvidenceScore>10</p2:TargetEvidenceScore>
          <p2:FramesToWaitBeforeDecay>5</p2:FramesToWaitBeforeDecay>
          <p2:ScoreDecayPerFrame>1</p2:ScoreDecayPerFrame>
          <p2:TriggerDelayMs>0</p2:TriggerDelayMs>
          <p2:PostRippleMs>250</p2:PostRippleMs>
        </Combinator>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>TTL</Selector>
      </Expression>
      <Expression xsi:type="scr:ExpressionTransform">
        <scr:Name>BoolToINT</scr:Name>
        <scr:Expression>it ? 1:0</scr:Expression>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="onix1:DigitalOutput">
          <onix1:DeviceName>BreakoutBoard/DigitalIO</onix1:DeviceName>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>TTLSignal</Name>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>EventCount</Selector>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="dsp:Buffer">
          <dsp:Count>1000</dsp:Count>
          <dsp:Skip xsi:nil="true" />
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:ObserveOn">
          <rx:Scheduler>NewThreadScheduler</rx:Scheduler>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p3:DataFrameWriter">
          <p3:FileName>rhd2164_.raw</p3:FileName>
          <p3:Suffix>FileCount</p3:Suffix>
          <p3:Buffered>true</p3:Buffered>
          <p3:Overwrite>false</p3:Overwrite>
          <p3:EnableCompression>false</p3:EnableCompression>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:ObserveOn">
          <rx:Scheduler>NewThreadScheduler</rx:Scheduler>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p3:DataFrameWriter">
          <p3:FileName>bno_data_.raw</p3:FileName>
          <p3:Suffix>FileCount</p3:Suffix>
          <p3:Buffered>true</p3:Buffered>
          <p3:Overwrite>false</p3:Overwrite>
          <p3:EnableCompression>false</p3:EnableCompression>
        </Combinator>
      </Expression>
      <Expression xsi:type="io:CsvWriter">
        <io:FileName>ripple_out_.raw</io:FileName>
        <io:Append>false</io:Append>
        <io:Overwrite>false</io:Overwrite>
        <io:Suffix>FileCount</io:Suffix>
        <io:IncludeHeader>false</io:IncludeHeader>
        <io:Selector>TTL,Score,EventCount,Probability,Clock,ConfigVersion,Prob0,Prob1,DecisionIndex</io:Selector>
      </Expression>
      <Expression xsi:type="scr:ExpressionTransform">
        <scr:Name>FsmParams</scr:Name>
        <scr:Expression>new(Threshold1 as T1, Threshold2 as T2, Threshold3 as T3, EvidenceTarget as Target, PostRippleMs as PostRippleMs, TriggerDelayMs as TriggerDelayMs)</scr:Expression>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:DistinctUntilChanged" />
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:Timestamp" />
      </Expression>
      <Expression xsi:type="io:CsvWriter">
        <io:FileName>ripple_config_.csv</io:FileName>
        <io:Append>false</io:Append>
        <io:Overwrite>false</io:Overwrite>
        <io:Suffix>FileCount</io:Suffix>
        <io:IncludeHeader>true</io:IncludeHeader>
        <io:Selector>Timestamp,Value.T1,Value.T2,Value.T3,Value.Target,Value.PostRippleMs,Value.TriggerDelayMs</io:Selector>
      </Expression>
      <Expression xsi:type="MemberSelector">
        <Selector>Probability</Selector>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>RippleProb</Name>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="p2:RippleDisplayBlock">
          <p2:DisplayOrder>
            <p2:int>42</p2:int>
            <p2:int>63</p2:int>
            <p2:int>48</p2:int>
            <p2:int>59</p2:int>
            <p2:int>61</p2:int>
            <p2:int>44</p2:int>
            <p2:int>57</p2:int>
            <p2:int>50</p2:int>
            <p2:int>47</p2:int>
            <p2:int>43</p2:int>
            <p2:int>56</p2:int>
            <p2:int>49</p2:int>
            <p2:int>46</p2:int>
            <p2:int>55</p2:int>
            <p2:int>53</p2:int>
            <p2:int>52</p2:int>
            <p2:int>45</p2:int>
            <p2:int>51</p2:int>
            <p2:int>38</p2:int>
            <p2:int>39</p2:int>
            <p2:int>60</p2:int>
            <p2:int>32</p2:int>
            <p2:int>33</p2:int>
            <p2:int>8</p2:int>
            <p2:int>62</p2:int>
            <p2:int>34</p2:int>
            <p2:int>54</p2:int>
            <p2:int>37</p2:int>
            <p2:int>36</p2:int>
            <p2:int>58</p2:int>
            <p2:int>41</p2:int>
            <p2:int>40</p2:int>
            <p2:int>23</p2:int>
            <p2:int>17</p2:int>
            <p2:int>26</p2:int>
            <p2:int>27</p2:int>
            <p2:int>0</p2:int>
            <p2:int>28</p2:int>
            <p2:int>29</p2:int>
            <p2:int>31</p2:int>
            <p2:int>35</p2:int>
            <p2:int>30</p2:int>
            <p2:int>10</p2:int>
            <p2:int>25</p2:int>
            <p2:int>24</p2:int>
            <p2:int>2</p2:int>
            <p2:int>21</p2:int>
            <p2:int>18</p2:int>
            <p2:int>22</p2:int>
            <p2:int>3</p2:int>
            <p2:int>16</p2:int>
            <p2:int>7</p2:int>
            <p2:int>5</p2:int>
            <p2:int>20</p2:int>
            <p2:int>11</p2:int>
            <p2:int>14</p2:int>
            <p2:int>15</p2:int>
            <p2:int>19</p2:int>
            <p2:int>4</p2:int>
            <p2:int>13</p2:int>
            <p2:int>12</p2:int>
            <p2:int>1</p2:int>
            <p2:int>9</p2:int>
            <p2:int>6</p2:int>
          </p2:DisplayOrder>
          <p2:DisplayDecimation>60</p2:DisplayDecimation>
          <p2:BlockSamples>1</p2:BlockSamples>
          <p2:RingDepth>256</p2:RingDepth>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:ObserveOn">
          <rx:Scheduler>NewThreadScheduler</rx:Scheduler>
        </Combinator>
      </Expression>
      <Expression xsi:type="Combinator">
        <Combinator xsi:type="rx:ObserveOn">
          <rx:Scheduler>NewThreadScheduler</rx:Scheduler>
        </Combinator>
      </Expression>
      <Expression xsi:type="rx:PublishSubject">
        <Name>EphysScaled</Name>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="onix1:AnalogInput">
            <onix1:DeviceName>BreakoutBoard/AnalogIO</onix1:DeviceName>
            <onix1:BufferSize>100</onix1:BufferSize>
            <onix1:DataType>S16</onix1:DataType>
          </Combinator>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="rx:ObserveOn">
            <rx:Scheduler>NewThreadScheduler</rx:Scheduler>
          </Combinator>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="Combinator">
          <Combinator xsi:type="p3:DataFrameWriter">
            <p3:FileName>analog_input_.raw</p3:FileName>
            <p3:Suffix>FileCount</p3:Suffix>
            <p3:Buffered>true</p3:Buffered>
            <p3:Overwrite>false</p3:Overwrite>
            <p3:EnableCompression>false</p3:EnableCompression>
          </Combinator>
        </Builder>
      </Expression>
      <Expression xsi:type="Disable">
        <Builder xsi:type="GroupWorkflow">
          <Name>VisualizerOLD</Name>
          <Workflow>
            <Nodes>
              <Expression xsi:type="SubscribeSubject">
                <Name>EphysScaled</Name>
              </Expression>
              <Expression xsi:type="Combinator">
                <Combinator xsi:type="dsp:Buffer">
                  <dsp:Count>1</dsp:Count>
                  <dsp:Skip xsi:nil="true" />
                </Combinator>
              </Expression>
              <Expression xsi:type="Combinator">
                <Combinator xsi:type="dsp:ConvertScale">
                  <dsp:Depth>F32</dsp:Depth>
                  <dsp:Scale>800</dsp:Scale>
                  <dsp:Shift>0</dsp:Shift>
                </Combinator>
              </Expression>
              <Expression xsi:type="Combinator">
                <Combinator xsi:type="rx:ObserveOn">
                  <rx:Scheduler>NewThreadScheduler</rx:Scheduler>
                </Combinator>
              </Expression>
              <Expression xsi:type="SubscribeSubject">
                <Name>RippleProb</Name>
              </Expression>
